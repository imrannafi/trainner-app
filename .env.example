# Copy to .env.local for local development, and set the same values in your hosting provider.
# All three are safe to expose to the browser.

# Supabase > Project Settings > API
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Public half of the VAPID key pair used for push notifications (see supabase/ARCHITECTURE.md).
# Leave empty to run without push; in-app notifications still work.
VITE_VAPID_PUBLIC_KEY=""

# Never put the service-role key or the VAPID private key here. They belong only in
# Supabase Edge Function secrets, or in your shell when running scripts/upload-coach-photo.mjs.
